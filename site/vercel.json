{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/catalog/item/:path*",
      "destination": "https://webcatalogrlbx.vercel.app/catalog/item/:path*"
    },
    {
      "source": "/catalog/thumbs/:path*",
      "destination": "https://webcatalogrlbx.vercel.app/catalog/thumbs/:path*"
    }
  ]
}
