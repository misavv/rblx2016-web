<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="4">
<Item class="Workspace" referent="RBX0"><Properties><string name="Name">Workspace</string></Properties>
<Item class="SpawnLocation" referent="RBX1"><Properties>
<string name="Name">RenderFloor</string><bool name="Anchored">true</bool><float name="Transparency">1</float>
<Vector3 name="size"><X>40</X><Y>1</Y><Z>40</Z></Vector3>
<CoordinateFrame name="CFrame"><X>0</X><Y>-0.5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>
</Properties></Item>
</Item>
<Item class="Lighting" referent="RBX2"><Properties>
<string name="Name">Lighting</string><float name="Brightness">1</float><bool name="GlobalShadows">false</bool><bool name="Outlines">false</bool>
<Color3 name="Ambient"><R>0.5</R><G>0.5</G><B>0.5</B></Color3>
<Color3 name="OutdoorAmbient"><R>0.5</R><G>0.5</G><B>0.5</B></Color3>
<float name="FogEnd">100000</float>
</Properties>
<Item class="Sky" referent="RBX3"><Properties><string name="Name">RenderSky</string><Content name="SkyboxBk"><url>rbxasset://textures/xboxrender/RenderBg.png</url></Content><Content name="SkyboxDn"><url>rbxasset://textures/xboxrender/RenderBg.png</url></Content><Content name="SkyboxFt"><url>rbxasset://textures/xboxrender/RenderBg.png</url></Content><Content name="SkyboxLf"><url>rbxasset://textures/xboxrender/RenderBg.png</url></Content><Content name="SkyboxRt"><url>rbxasset://textures/xboxrender/RenderBg.png</url></Content><Content name="SkyboxUp"><url>rbxasset://textures/xboxrender/RenderBg.png</url></Content><bool name="CelestialBodiesShown">false</bool><int name="StarCount">0</int></Properties></Item>
</Item>
</roblox>
